<Application x:Class="Ninho.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Ninho.Windows">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="NinhoInkBrush" Color="#193C35" />
          <SolidColorBrush x:Key="NinhoSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NinhoCanvasBrush" Color="#F3F4EF" />
          <SolidColorBrush x:Key="NinhoLineBrush" Color="#E6EAE3" />
          <SolidColorBrush x:Key="NinhoMintBrush" Color="#E9F2E8" />
          <SolidColorBrush x:Key="NinhoMutedBrush" Color="#50675E" />
          <SolidColorBrush x:Key="NinhoGreenBrush" Color="#235E50" />
          <SolidColorBrush x:Key="NinhoSoftBrush" Color="#F8F9F5" />
          <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F9FBF9" />
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F3F4EF" />
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E9F2E8" />
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#DDEDDD" />
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#235E50" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="NinhoInkBrush" Color="#F0F1F3" />
          <SolidColorBrush x:Key="NinhoSurfaceBrush" Color="#23252A" />
          <SolidColorBrush x:Key="NinhoCanvasBrush" Color="#191B20" />
          <SolidColorBrush x:Key="NinhoLineBrush" Color="#3B3E46" />
          <SolidColorBrush x:Key="NinhoMintBrush" Color="#303A37" />
          <SolidColorBrush x:Key="NinhoMutedBrush" Color="#AEB3BE" />
          <SolidColorBrush x:Key="NinhoGreenBrush" Color="#A8D7BC" />
          <SolidColorBrush x:Key="NinhoSoftBrush" Color="#2B2E35" />
          <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#23252A" />
          <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#202228" />
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#191B20" />
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#303A37" />
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#39423E" />
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#A8D7BC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#527969</Color>
      <SolidColorBrush x:Key="NinhoGreen" Color="#527969" />
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#527969" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#466B5C" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3D604F" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
      <FontFamily x:Key="NinhoDisplayFont">ms-appx:///Assets/Fonts/Fraunces-Medium.ttf#Fraunces Medium</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DMSans.ttf#DM Sans</FontFamily>
      <FontFamily x:Key="NinhoMediumFont">ms-appx:///Assets/Fonts/DMSans-Medium.ttf#DM Sans Medium</FontFamily>
      <FontFamily x:Key="NinhoSemiBoldFont">ms-appx:///Assets/Fonts/DMSans-SemiBold.ttf#DM Sans SemiBold</FontFamily>
      <FontFamily x:Key="NinhoBoldFont">ms-appx:///Assets/Fonts/DMSans-Bold.ttf#DM Sans</FontFamily>
      <Style x:Key="NinhoPlainButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.8"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.6"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NinhoPlainButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource NinhoGreenBrush}"/><Setter Property="Foreground" Value="{ThemeResource NinhoSurfaceBrush}"/><Setter Property="Padding" Value="17,11"/><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="{StaticResource NinhoSemiBoldFont}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="NinhoThemeChoiceStyle" TargetType="ToggleButton">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ChoiceRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ChoiceRoot.Opacity" Value="0.8"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ChoiceRoot.Opacity" Value="0.6"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}" /><Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" /></Style>
      <Style TargetType="local:OriginalIcon"><Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}" /></Style>
      <Style TargetType="NavigationViewItem"><Setter Property="Margin" Value="8,3" /><Setter Property="CornerRadius" Value="11" /><Setter Property="MinHeight" Value="45" /><Setter Property="FontSize" Value="13" /></Style>
      <Style x:Key="NinhoCardStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource NinhoSurfaceBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource NinhoLineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="24" /></Style>
      <Style x:Key="NinhoTileStyle" TargetType="Button"><Setter Property="Background" Value="{ThemeResource NinhoSurfaceBrush}" /><Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource NinhoLineBrush}" /><Setter Property="CornerRadius" Value="15" /></Style>
      <Style TargetType="Button"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="17,11" /><Setter Property="FontSize" Value="12" /><Setter Property="FontFamily" Value="{StaticResource NinhoSemiBoldFont}"/><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Background" Value="{ThemeResource NinhoSurfaceBrush}"/><Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource NinhoLineBrush}"/></Style>
      <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="8" /></Style>
      <Style x:Key="NinhoAnswerStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Background" Value="{ThemeResource NinhoSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource NinhoInkBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource NinhoLineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18,15"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource NinhoGreenBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="BorderElement.BorderBrush" Value="{ThemeResource NinhoMutedBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="BorderElement.BorderBrush" Value="{ThemeResource NinhoGreenBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="BorderElement.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FontFamily="{StaticResource NinhoSemiBoldFont}" FontSize="13" Foreground="{ThemeResource NinhoInkBrush}" Margin="0,0,0,9" TextWrapping="Wrap" Visibility="Collapsed" x:DeferLoadStrategy="Lazy"/>
            <Border x:Name="BorderElement" Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" MinHeight="{TemplateBinding MinHeight}" Control.IsTemplateFocusTarget="True"/>
            <ScrollViewer x:Name="ContentElement" Grid.Row="1" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" ZoomMode="Disabled"/>
            <TextBlock x:Name="PlaceholderTextContentPresenter" Grid.Row="1" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Foreground="{ThemeResource NinhoMutedBrush}" Text="{TemplateBinding PlaceholderText}" FontSize="{TemplateBinding FontSize}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource NinhoMutedBrush}" x:Load="False"/>
          </Grid>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
