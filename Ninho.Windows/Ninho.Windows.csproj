<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../resources/icon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>Ninho</AssemblyName>
    <RootNamespace>Ninho.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <ProjectReference Include="../Ninho.Core/Ninho.Core.csproj" />
    <Content Include="../resources/icon.png" Link="Assets/icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../resources/icon.ico" Link="Assets/icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../resources/icon.svg" Link="Assets/icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../resources/seed.json" Link="Assets/seed.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Icons/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Sounds/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged dotnet publish does not automatically include WinUI's generated payload. -->
  <Target Name="IncludeCompiledXamlInPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The compiled WinUI resource index is missing. Build before publishing." />
    <Error Condition="!Exists('$(TargetDir)App.xbf')" Text="The compiled WinUI application XAML is missing." />
    <ItemGroup>
      <_CompiledXamlForPublish Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_CompiledXamlForPublish)" RelativePath="%(_CompiledXamlForPublish.RecursiveDir)%(_CompiledXamlForPublish.Filename)%(_CompiledXamlForPublish.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
