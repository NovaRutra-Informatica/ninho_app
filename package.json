{
  "name": "ninho-estudos",
  "productName": "Ninho",
  "version": "1.1.5",
  "description": "Seu espaço de estudos, revisões e conquistas.",
  "author": "Alessandro",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "native:build": "powershell -NoProfile -File scripts/native.ps1 -Action Build",
    "native:test": "powershell -NoProfile -File scripts/native.ps1 -Action Test",
    "native:publish": "powershell -NoProfile -File scripts/native.ps1 -Action Publish",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "start": "electron .",
    "package": "npm run build && electron-builder --win dir --x64",
    "dist": "npm run build && electron-builder --win portable --x64",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/e2e/*.ts\" \"*.{ts,json,html,md}\"",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "installer": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "adm-zip": "0.6.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "latest",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "latest",
    "jsdom": "latest",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "latest"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "com.aless.ninho",
    "productName": "Ninho",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Ninho-${version}.exe"
    },
    "electronDist": "./node_modules/electron/dist",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ninho",
      "uninstallDisplayName": "Ninho",
      "artifactName": "Ninho-Setup-${version}.exe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
